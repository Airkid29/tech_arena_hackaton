# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_TOKEN_TTL_DAYS=7

# Supabase server credentials. Never expose the service-role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# AI providers. The app uses AI_PROVIDER when configured and clearly labels fallbacks.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RODIUM_API_KEY=
RODIUM_API_URL=https://api.rodiumai.io/v1/chat/completions
# Required when RODIUM_API_KEY is set; use the exact model identifier from RodiumAI.
RODIUM_MODEL=

# Optional read-only Gophish reporting integration. Never place these in VITE_* variables.
GOPHISH_URL=
GOPHISH_API_KEY=
GOPHISH_ADMIN_ID=

# Optional SMTP, reserved for authorized training invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=VIGILO Formations
